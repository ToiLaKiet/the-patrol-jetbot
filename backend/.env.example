# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True
ENVIRONMENT=development

# Database
DATABASE_URL=sqlite:///./data/patrol_jetbot.db

# Storage Directories
UPLOAD_DIR=./data/uploads
KEYFRAME_DIR=./data/keyframes

# CORS Settings (comma-separated origins)
ALLOWED_ORIGINS=*

# Robot Settings
ROBOT_HEARTBEAT_TIMEOUT=10.0
DEFAULT_LINEAR_SPEED=0.4
DEFAULT_ANGULAR_SPEED=0.5
